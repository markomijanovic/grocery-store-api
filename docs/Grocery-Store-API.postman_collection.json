        "body": {
          "mode": "raw",
          "raw": "{\n  \"firstName\": \"Demo\",\n  \"lastName\": \"Reviewer\",\n  \"email\": \"postman.employee@example.test\",\n  \"password\": \"{{demoPassword}}\",\n  \"nodeId\": \"bezanija\"\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test(\"Expected HTTP status\", () => pm.response.to.have.status(201));",
              "if (pm.response.code === 201) pm.collectionVariables.set(\"createdEmployeeId\", pm.response.json().id);"
            ]
          }
        }
      ]
    },
    {
      "name": "Read created employee",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/employees/{{createdEmployeeId}}",
        "header": [],
