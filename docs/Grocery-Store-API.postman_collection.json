          }
        }
      ]
    },
    {
      "name": "Employees: subtree",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/nodes/novi-beograd/employees?includeDescendants=true",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
          ]
        }
      },
      "event": [
        {
          "listen": "test",
