          }
        }
      ]
    },
    {
      "name": "Managers: direct node",
      "request": {
        "method": "GET",
        "url": "{{baseUrl}}/api/v1/nodes/novi-beograd/managers?includeDescendants=false",
        "header": [],
        "auth": {
          "type": "bearer",
          "bearer": [
            {
              "key": "token",
              "value": "{{managerToken}}",
              "type": "string"
            }
