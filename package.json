{
  "name": "grocery-store-api",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node --env-file=.env --watch src/server.js",
    "start": "node --env-file=.env src/server.js",
    "seed": "node --env-file=.env scripts/seed.js",
    "test": "node --test test/unit/*.test.js",
    "setup": "node scripts/setup-env.js",
    "demo": "node --env-file=.env scripts/demo.js",
    "test:integration": "node --env-file=.env --test --test-concurrency=1 test/integration/*.test.js",
    "test:all": "npm test && npm run test:integration"
  },
  "dependencies": {
    "argon2": "^0.45.2",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jose": "^6.2.17",
    "mongodb": "^7.8.0",
    "zod": "^4.6.7"
  },
  "description": "Hierarchical employee and manager access control with Node.js and MongoDB",
  "engines": {
    "node": ">=24 <25"
  },
  "devDependencies": {
    "supertest": "7.3.2"
  }
}
